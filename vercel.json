{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/clusters/palmiera/",
      "destination": "/clusters/palmiera-1/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}